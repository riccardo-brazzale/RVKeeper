DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=rvkeeper
DB_USER=rvkeeper
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional SMTP settings; SMTP_* names match the production environment.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=RVKeeper <noreply@example.invalid>
