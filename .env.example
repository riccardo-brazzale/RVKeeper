DJANGO_SECRET_KEY=generate-a-unique-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://example.com
# Keep these false for the initial HTTP setup; enable after configuring HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
RVKEEPER_SERVER_NAME=example.com
RVKEEPER_TLS_CERTIFICATE=
RVKEEPER_TLS_KEY=

DB_NAME=rvkeeper
DB_USER=rvkeeper_user
DB_PASSWORD=generate-a-unique-random-value
DB_HOST=127.0.0.1
DB_PORT=5432

# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend to enable SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com

# Initial workshop used by the idempotent bootstrap/seed command.
RVKEEPER_WORKSHOP_NAME=RVKeeper Demo Workshop
RVKEEPER_WORKSHOP_SLUG=rvkeeper-demo
